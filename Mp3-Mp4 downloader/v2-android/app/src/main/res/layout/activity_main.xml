<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video İndirici"
            android:textColor="#2E7D32"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="YouTube ve diğer sitelerden MP3 / MP4"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Video linkini yapıştırın"
            android:inputType="textUri"
            android:maxLines="3" />

        <Button
            android:id="@+id/yapistir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Panodan yapıştır" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Biçim"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/bicim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mp4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="MP4 (video)" />

            <RadioButton
                android:id="@+id/mp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="MP3 (ses)" />
        </RadioGroup>

        <TextView
            android:id="@+id/kaliteBaslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kalite"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/kalite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/indir"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D32"
            android:text="İNDİR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/iptal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İptal"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/cubuk"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100" />

        <TextView
            android:id="@+id/durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hazırlanıyor..."
            android:textColor="#555555" />

        <Button
            android:id="@+id/guncelle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="🔄 İndirme motorunu güncelle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Dosyalar: İndirilenler / VideoIndirici\nİpucu: YouTube'da Paylaş → Video İndirici"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
