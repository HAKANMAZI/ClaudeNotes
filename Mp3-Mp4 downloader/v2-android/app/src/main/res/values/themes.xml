<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C8E6C9</item>
        <item name="colorOnPrimaryContainer">#0B3D0F</item>
        <item name="colorSecondaryContainer">#C8E6C9</item>
        <item name="colorOnSecondaryContainer">#0B3D0F</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:colorBackground">#F2F5F2</item>
        <item name="android:windowBackground">#F2F5F2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Kart" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>

    <style name="Baslik" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#5F6B5F</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
